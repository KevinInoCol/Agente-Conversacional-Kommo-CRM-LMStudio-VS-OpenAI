# ============================================================
# Plantilla de variables de entorno. Copia este archivo a .env
# y rellena con tus valores reales:  cp .env.example .env
# NUNCA subas el .env real al repositorio (está en .gitignore).
# ============================================================

# ─── Proveedor de LLM ───
# API key de OpenAI (requerida si usas el proveedor "openai").
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM activo: "openai" o "lmstudio". Cambias esta línea y reinicias uvicorn.
LLM_PROVIDER=openai

# --- LM Studio (API local compatible con OpenAI) ---
# Solo se usan si LLM_PROVIDER=lmstudio. La api_key es un placeholder
# (LM Studio no la valida, pero el cliente exige que exista).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3-8b
LMSTUDIO_API_KEY=lm-studio

# ─── Memoria del agente: PostgreSQL / Supabase ───
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=tu_password
DB_HOST=aws-1-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# DB_SSLMODE=require            # opcional; 'disable' para Postgres local sin SSL

# ─── LlamaCloud (LlamaParse para parsear los PDFs del RAG) ───
LLAMA_CLOUD_API_KEY=llx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Kommo CRM ───
KOMMO_SUBDOMAIN=tu_subdominio
KOMMO_ACCESS_TOKEN=eyJ0eXAiOiJKV1Qi...tu_token_largo...
KOMMO_PIPELINE_ID=0000000
KOMMO_LEAD_INTERESADO_STATUS_ID=0000000
KOMMO_LEAD_CALIFICADO_STATUS_ID=0000000
KOMMO_LEAD_CERRAR_VENTA_STATUS_ID=0000000
KOMMO_RESPONSE_FIELD_ID=0000000
KOMMO_SWITCH_FIELD_ID=0000000
KOMMO_MARCA_INTERES_FIELD_ID=0000000
KOMMO_METODO_PAGO_FIELD_ID=0000000
KOMMO_SALESBOT_ID=00000

# ─── Qdrant (vector store del RAG) ───
QDRANT_URL=https://tu-instancia.qdrant.tudominio.com
QDRANT_API_KEY=tu_api_key_qdrant
QDRANT_COLLECTION=nombre_de_tu_coleccion

# ─── Google Sheets (inventario de inmuebles, tool buscar_inmuebles) ───
# Ruta al JSON de la service account (relativa a la raíz del proyecto).
# La hoja debe estar COMPARTIDA con el client_email del JSON (permiso de lectura).
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/TU_SHEET_ID/edit
# GOOGLE_SHEET_ID=             # alternativa: solo el id en vez de la URL completa
# GOOGLE_SHEET_WORKSHEET=      # opcional: nombre de la pestaña (default: la primera)

# ─── Opcional ───
# BOT_NAME=Andrea
